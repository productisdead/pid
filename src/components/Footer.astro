---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, NAV } from '@/site.config';
const socials = (Object.entries(SITE.socials) as [keyof typeof SITE.socials, string][]).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="mt-28 border-t border-line">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
        A cynical look at why AI didn't kill product management, and the tools to prove it.
      </p>
      <p class="hand mt-5 text-2xl text-ink-2">Not dead yet.</p>
    </div>
    <div>
      <p class="eyebrow">Explore</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {NAV.map((n) => <li><a class="link text-ink-2 hover:text-ink" href={n.href}>{n.label}</a></li>)}
        <li><a class="link text-ink-2 hover:text-ink" href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Follow</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="link inline-flex items-center gap-2 text-ink-2 hover:text-ink" href="/rss.xml"><Icon name="rss" size={14} /> RSS feed</a></li>
        {socials.map(([name, url]) => (
          <li><a class="link inline-flex items-center gap-2 capitalize text-ink-2 hover:text-ink" href={url} rel="me noopener" target="_blank"><Icon name={name === 'x' ? 'x' : name} size={14} /> {name === 'x' ? 'X / Twitter' : name}</a></li>
        ))}
        <li><a class="link text-ink-2 hover:text-ink" href={`mailto:${SITE.author.email}`}>Email</a></li>
      </ul>
    </div>
  </div>
  <div class="container-x flex flex-col gap-2 border-t border-line py-6 text-xs text-muted sm:flex-row sm:justify-between">
    <p>© {year} {SITE.name}. Written by a human. Mostly.</p>
    <p>Press <kbd class="kbd">⌘K</kbd> to search · <kbd class="kbd">/</kbd> also works</p>
  </div>
</footer>
