---
import type { Skill } from '@/lib/content';
interface Props { skill: Skill; size?: 'card' | 'hero'; class?: string }
const { skill, size = 'card', class: cls = '' } = Astro.props;
const { icon, color, title, category } = skill.data;
const hero = size === 'hero';
// Deterministic tilt per skill, so every card feels hand-placed
const seed = [...skill.id].reduce((a, c) => a + c.charCodeAt(0), 0);
const tilt = ((seed % 9) - 4) * 1.5;
---
<div
  class:list={[`tone-${color} relative isolate overflow-hidden bg-[var(--tone)] text-[var(--tone-ink)]`, hero ? 'aspect-[16/10] rounded-3xl' : 'aspect-[4/3] rounded-xl', cls]}
  transition:name={`skill-cover-${skill.id}`}
>
  <div class="absolute inset-0 -z-10 opacity-30 [background-image:radial-gradient(currentColor_1px,transparent_1px)] [background-size:16px_16px]"></div>
  <div class="absolute -right-10 -top-10 -z-10 size-48 rounded-full bg-white/20 blur-2xl"></div>

  <!-- fake file window -->
  <div
    class:list={['absolute left-1/2 top-1/2 w-[62%] -translate-x-1/2 -translate-y-[42%] rounded-lg bg-[#FFFDF7] text-[#141112] shadow-[0_18px_40px_-12px_rgba(0,0,0,.35)] ring-1 ring-black/10 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-translate-y-[50%] group-hover:rotate-0', hero && 'w-[68%] sm:w-[52%]']}
    style={`rotate:${tilt}deg`}
  >
    <div class="flex items-center gap-1 border-b border-black/10 px-2.5 py-1.5">
      <span class="size-1.5 rounded-full bg-[#E4572E]"></span><span class="size-1.5 rounded-full bg-[#FED74F]"></span><span class="size-1.5 rounded-full bg-[#C5E17A]"></span>
      <span class:list={['ml-1.5 truncate font-mono text-black/50', hero ? 'text-xs' : 'text-[0.6rem]']}>{skill.id}/SKILL.md</span>
    </div>
    <div class:list={['flex items-center gap-3', hero ? 'p-6' : 'p-3.5']}>
      <span class:list={['grid shrink-0 place-items-center rounded-lg bg-black/5', hero ? 'size-16 text-4xl' : 'size-9 text-xl']} aria-hidden="true">{icon}</span>
      <div class="min-w-0 flex-1 space-y-1.5">
        <div class:list={['truncate font-display font-bold leading-tight', hero ? 'text-2xl' : 'text-[0.8rem]']}>{title}</div>
        <div class="h-1 w-11/12 rounded bg-black/10"></div>
        <div class="h-1 w-2/3 rounded bg-black/10"></div>
      </div>
    </div>
  </div>
  <span class:list={['absolute bottom-3 left-3 rounded-full bg-black/10 px-2 py-0.5 font-mono font-medium uppercase tracking-wider', hero ? 'hidden text-xs sm:inline' : 'text-[0.6rem]']}>{category}</span>
</div>
