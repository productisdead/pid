---
import Icon from './Icon.astro';
---
<dialog data-search aria-label="Search" class="m-auto mt-[12vh] w-[min(640px,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-line-strong bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-sm open:animate-[pop_.25s_var(--ease-out-expo)]">
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" class="text-muted" />
    <input type="search" placeholder="Search essays and skills…" aria-label="Search essays and skills" role="combobox" aria-expanded="true" aria-controls="search-results" autocomplete="off" class="h-14 w-full bg-transparent text-base outline-none placeholder:text-muted" />
    <kbd class="kbd">esc</kbd>
  </div>
  <ul id="search-results" data-results role="listbox" class="max-h-[60vh] overflow-y-auto p-2"></ul>
  <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 text-xs text-muted">
    <span class="flex items-center gap-1"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> navigate</span>
    <span class="flex items-center gap-1"><kbd class="kbd">↵</kbd> open</span>
    <span class="hand ml-auto text-sm">not dead yet.</span>
  </div>
</dialog>
<style is:global>
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(0.98); } }
</style>
<script>
  import '@/scripts/search';
</script>
