---
import type { Skill } from '@/lib/content';
import SkillCover from './SkillCover.astro';
import { SITE } from '@/site.config';
interface Props { skill: Skill; index?: number }
const { skill, index = 0 } = Astro.props;
const { title, description, category, tags, date, featured } = skill.data;
---
<li
  data-reveal
  style={`--d:${index % 6}`}
  data-skill
  data-category={category}
  data-title={title.toLowerCase()}
  data-haystack={`${title} ${description} ${category} ${tags.join(' ')}`.toLowerCase()}
  data-date={date.valueOf()}
  data-featured={featured ? '1' : '0'}
>
  <a href={`/skills/${skill.id}`} class="group block rounded-2xl p-2 -m-2 transition-colors hover:bg-paper-2/70">
    <div class="overflow-hidden rounded-xl ring-1 ring-line transition-shadow duration-300 group-hover:shadow-card">
      <SkillCover skill={skill} />
    </div>
    <div class="mt-3.5 flex items-start justify-between gap-3 px-0.5">
      <div class="min-w-0">
        <h3 class="truncate font-display text-[1.05rem] font-semibold tracking-tight">{title}</h3>
        <p class="mt-0.5 truncate text-sm text-muted">by {SITE.name} · {category}</p>
      </div>
    </div>
  </a>
</li>
