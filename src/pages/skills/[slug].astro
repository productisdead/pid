---
import Base from '@/layouts/Base.astro';
import SkillCover from '@/components/SkillCover.astro';
import SkillCard from '@/components/SkillCard.astro';
import Icon from '@/components/Icon.astro';
import ChatLauncher from '@/components/ChatLauncher.astro';
import { getSkills, formatDate, toSkillFile, skillGithub, skillChatLinks, skillTldr, type Skill } from '@/lib/content';
import { SITE } from '@/site.config';

export async function getStaticPaths() {
  const skills = await getSkills();
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: {
      skill,
      related: skills
        .filter((s) => s.id !== skill.id)
        .sort((a, b) => Number(b.data.category === skill.data.category) - Number(a.data.category === skill.data.category))
        .slice(0, 3),
    },
  }));
}
interface Props { skill: Skill; related: Skill[] }
const { skill, related } = Astro.props;
const d = skill.data;
const raw = toSkillFile(skill);
const rawUrl = new URL(`/skills/${skill.id}.md`, Astro.site).toString();
const gh = skillGithub(skill.id);
const chat = skillChatLinks(d.title, rawUrl);
const tldr = skillTldr(skill);
// Description without its trailing "Use when…" trigger sentence
const summary = d.description.replace(/\s*Use (it )?when[\s\S]*$/i, '').trim() || d.description;
const lines = raw.split('\n').length;
const collapsible = lines > 28;
const install = `mkdir -p ~/.claude/skills/${skill.id} && curl -fsSL ${rawUrl} -o ~/.claude/skills/${skill.id}/SKILL.md`;
const meta: [string, string][] = [
  ['Category', d.category],
  ['Level', d.level],
  ['Version', d.version],
  ['Updated', formatDate(d.updated ?? d.date, 'short')],
];
---
<Base title={d.title} description={d.description}>
  <div class="container-x pt-8 sm:pt-12">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted">
      <a href="/skills" class="link hover:text-ink">Skills</a><span>/</span>
      <a href={`/skills?category=${encodeURIComponent(d.category)}`} class="link hover:text-ink">{d.category}</a><span>/</span>
      <span class="truncate text-ink">{d.title}</span>
    </nav>

    <div class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <SkillCover skill={skill} size="hero" class="shadow-card ring-1 ring-line" />
      </div>

      <div class="order-2 min-w-0 lg:order-none lg:col-start-1 lg:row-start-2">
        <!-- TL;DR -->
        <section aria-labelledby="tldr-title" class="rounded-2xl border border-line bg-card p-6 sm:p-7">
          <div class="flex items-center gap-2.5">
            <span class="rounded-md bg-yellow px-2 py-0.5 font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand-ink">TL;DR</span>
            <h2 id="tldr-title" class="sr-only">TL;DR</h2>
          </div>
          <p class="mt-4 font-display text-xl font-semibold leading-snug tracking-tight sm:text-2xl">{summary}</p>
          {(tldr.when.length > 0 || tldr.steps.length > 0) && (
            <div class="mt-6 grid gap-6 border-t border-line pt-6 sm:grid-cols-2 sm:gap-8">
              {tldr.when.length > 0 && (
                <div>
                  <p class="eyebrow">Reach for it when</p>
                  <ul class="mt-3 space-y-2.5 text-[0.95rem] leading-snug text-ink-2">
                    {tldr.when.map((w) => (
                      <li class="flex gap-2.5"><span class="mt-[0.45em] size-1.5 flex-none rounded-full bg-ink"></span><span>{w}</span></li>
                    ))}
                  </ul>
                </div>
              )}
              {tldr.steps.length > 0 && (
                <div>
                  <p class="eyebrow">What it does</p>
                  <ol class="mt-3 space-y-2 text-[0.95rem] leading-snug text-ink-2">
                    {tldr.steps.map((st, i) => (
                      <li class="flex gap-3"><span class="grid size-5 flex-none place-items-center rounded-full bg-paper-2 font-mono text-[0.65rem] font-bold text-ink ring-1 ring-line">{i + 1}</span><span>{st}</span></li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          )}
        </section>

        <!-- The file itself -->
        <section class="mt-8" aria-label="SKILL.md">
          <div class="overflow-hidden rounded-2xl border border-line bg-paper-2">
            <div class="flex items-center gap-3 border-b border-line bg-card px-4 py-2.5">
              <span class="flex gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-red/70"></span><span class="size-2.5 rounded-full bg-yellow"></span><span class="size-2.5 rounded-full bg-lime"></span></span>
              <span class="font-mono text-xs text-muted">{skill.id}/SKILL.md</span>
              <span class="ml-auto hidden font-mono text-xs text-muted sm:inline">{lines} lines</span>
              <button type="button" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium text-muted hover:bg-paper-2 hover:text-ink" data-copy-from="#skill-raw">
                <Icon name="copy" size={14} /> <span data-copy-label>Copy</span>
              </button>
            </div>
            <div class="relative" data-file data-collapsed={collapsible ? 'true' : 'false'}>
              <pre class="file-body whitespace-pre-wrap [overflow-wrap:anywhere] p-5 font-mono text-[0.8rem] leading-relaxed text-ink-2"><code id="skill-raw">{raw}</code></pre>
              {collapsible && (
                <div class="file-fade absolute inset-x-0 bottom-0 flex items-end justify-center pb-5">
                  <button type="button" data-expand class="btn btn-ghost h-10 bg-card px-5 text-sm">
                    Show full file <span class="text-muted">· {lines} lines</span>
                  </button>
                </div>
              )}
            </div>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="order-1 min-w-0 lg:order-none lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div>
        <div class="card p-6 shadow-card">
          <span class="eyebrow">{d.category}</span>
          <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight">{d.title}</h1>
          <p class="mt-3 text-sm text-muted">by <a href="/manifesto" class="link text-ink">{SITE.name}</a></p>

          <div class="mt-6 grid gap-2">
            <button type="button" class="btn btn-primary h-11 w-full" data-copy-from="#skill-raw">
              <Icon name="copy" size={16} /> <span data-copy-label>Copy SKILL.md</span>
            </button>
            <div class="grid grid-cols-2 gap-2">
              <a href={`/skills/${skill.id}.md`} download="SKILL.md" class="btn btn-ghost h-11 w-full">
                <Icon name="download" size={16} /> Download
              </a>
              <a href={gh.folder} target="_blank" rel="noopener" class="btn btn-ghost h-11 w-full">
                <Icon name="github" size={16} /> GitHub
              </a>
            </div>
          </div>

          <ChatLauncher links={chat} />

          <div class="mt-6">
            <p class="text-xs font-semibold text-ink-2">Install in Claude Code</p>
            <div class="group relative mt-2 rounded-lg border border-line bg-paper-2">
              <code class="block overflow-x-auto whitespace-nowrap p-3 pr-12 font-mono text-[0.7rem] text-ink-2 [scrollbar-width:thin]">{install}</code>
              <button type="button" data-copy={install} class="absolute right-1.5 top-1.5 grid size-7 place-items-center rounded-md bg-card text-muted ring-1 ring-line hover:text-ink" aria-label="Copy install command">
                <Icon name="copy" size={13} />
              </button>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-muted">ChatGPT, Claude.ai or Cursor: paste the file into project instructions or rules. Source and history on <a href={gh.file} target="_blank" rel="noopener" class="link text-ink-2">GitHub</a>.</p>
          </div>

          <dl class="mt-6 divide-y divide-line border-t border-line text-sm">
            {meta.map(([k, v]) => (
              <div class="flex justify-between py-2.5"><dt class="text-muted">{k}</dt><dd class="font-medium capitalize">{v}</dd></div>
            ))}
            <div class="flex justify-between gap-4 py-2.5"><dt class="text-muted">Works with</dt><dd class="text-right font-medium">{d.tools.join(', ')}</dd></div>
          </dl>
          {d.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">{d.tags.map((t) => <span class="chip">#{t}</span>)}</div>
          )}
        </div>
        </div>
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <section class="container-x mt-28">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight">More skills</h2>
        <a href="/skills" class="link inline-flex items-center gap-2 text-sm font-semibold">View all <Icon name="arrow" size={14} /></a>
      </div>
      <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s, i) => <SkillCard skill={s} index={i} />)}
      </ul>
    </section>
  )}
</Base>

<style>
  [data-file][data-collapsed='true'] .file-body { max-height: 30rem; overflow: hidden; }
  [data-file][data-collapsed='false'] .file-fade { display: none; }
  .file-fade { height: 9rem; background: linear-gradient(to bottom, transparent, var(--paper-2) 70%); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((b) =>
      b.addEventListener('click', () => b.closest<HTMLElement>('[data-file]')!.dataset.collapsed = 'false'),
    );
  });
</script>
