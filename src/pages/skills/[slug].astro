---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SkillCover from '@/components/SkillCover.astro';
import SkillCard from '@/components/SkillCard.astro';
import Icon from '@/components/Icon.astro';
import { getSkills, formatDate, toSkillFile, type Skill } from '@/lib/content';
import { SITE } from '@/site.config';

export async function getStaticPaths() {
  const skills = await getSkills();
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: {
      skill,
      related: skills
        .filter((s) => s.id !== skill.id)
        .sort((a, b) => Number(b.data.category === skill.data.category) - Number(a.data.category === skill.data.category))
        .slice(0, 3),
    },
  }));
}
interface Props { skill: Skill; related: Skill[] }
const { skill, related } = Astro.props;
const { Content } = await render(skill);
const d = skill.data;
const raw = toSkillFile(skill);
const rawUrl = new URL(`/skills/${skill.id}.md`, Astro.site).toString();
const install = `mkdir -p ~/.claude/skills/${skill.id} && curl -fsSL ${rawUrl} -o ~/.claude/skills/${skill.id}/SKILL.md`;
const meta: [string, string][] = [
  ['Category', d.category],
  ['Level', d.level],
  ['Version', d.version],
  ['Updated', formatDate(d.updated ?? d.date, 'short')],
];
---
<Base title={d.title} description={d.description}>
  <div class="container-x pt-8 sm:pt-12">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted">
      <a href="/skills" class="link hover:text-ink">Skills</a><span>/</span>
      <a href={`/skills?category=${encodeURIComponent(d.category)}`} class="link hover:text-ink">{d.category}</a><span>/</span>
      <span class="truncate text-ink">{d.title}</span>
    </nav>

    <div class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <SkillCover skill={skill} size="hero" class="shadow-card ring-1 ring-line" />
      </div>

      <div class="order-2 min-w-0 lg:order-none lg:col-start-1 lg:row-start-2">
        <!-- Preview / Raw tabs -->
        <div class="lg:mt-2">
          <div role="tablist" aria-label="Skill content" class="flex items-center gap-1 border-b border-line">
            <button type="button" role="tab" id="tab-preview" aria-controls="panel-preview" aria-selected="true" data-tab="preview" class="tab">Preview</button>
            <button type="button" role="tab" id="tab-raw" aria-controls="panel-raw" aria-selected="false" data-tab="raw" class="tab">SKILL.md</button>
            <button type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-muted hover:bg-paper-2 hover:text-ink" data-copy-from="#skill-raw">
              <Icon name="copy" size={14} /> <span data-copy-label>Copy</span>
            </button>
          </div>
          <div id="panel-preview" role="tabpanel" aria-labelledby="tab-preview" class="prose prose-lg prose-pid mt-8 min-w-0">
            <Content />
          </div>
          <div id="panel-raw" role="tabpanel" aria-labelledby="tab-raw" hidden class="mt-8">
            <pre class="max-h-[70vh] overflow-auto rounded-xl border border-line bg-paper-2 p-5 font-mono text-[0.82rem] leading-relaxed text-ink-2"><code id="skill-raw">{raw}</code></pre>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="order-1 min-w-0 lg:order-none lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="lg:sticky lg:top-24">
        <div class="card p-6 shadow-card">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">{d.category}</span>
            <span class="rounded-full bg-yellow px-2.5 py-0.5 text-xs font-bold text-brand-ink">{d.price}</span>
          </div>
          <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight">{d.title}</h1>
          <p class="mt-3 text-ink-2">{d.description}</p>
          <p class="mt-3 text-sm text-muted">by <a href="/manifesto" class="link text-ink">{SITE.name}</a></p>

          <div class="mt-6 grid gap-2">
            <button type="button" class="btn btn-primary h-11 w-full" data-copy-from="#skill-raw">
              <Icon name="copy" size={16} /> <span data-copy-label>Copy SKILL.md</span>
            </button>
            <a href={`/skills/${skill.id}.md`} download="SKILL.md" class="btn btn-ghost h-11 w-full">
              <Icon name="download" size={16} /> Download
            </a>
          </div>

          <div class="mt-6">
            <p class="text-xs font-semibold text-ink-2">Install in Claude Code</p>
            <div class="group relative mt-2 rounded-lg border border-line bg-paper-2">
              <code class="block overflow-x-auto whitespace-nowrap p-3 pr-12 font-mono text-[0.7rem] text-ink-2 [scrollbar-width:thin]">{install}</code>
              <button type="button" data-copy={install} class="absolute right-1.5 top-1.5 grid size-7 place-items-center rounded-md bg-card text-muted ring-1 ring-line hover:text-ink" aria-label="Copy install command">
                <Icon name="copy" size={13} />
              </button>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-muted">ChatGPT, Claude.ai or Cursor: paste the file into project instructions or rules.</p>
          </div>

          <dl class="mt-6 divide-y divide-line border-t border-line text-sm">
            {meta.map(([k, v]) => (
              <div class="flex justify-between py-2.5"><dt class="text-muted">{k}</dt><dd class="font-medium capitalize">{v}</dd></div>
            ))}
            <div class="flex justify-between gap-4 py-2.5"><dt class="text-muted">Works with</dt><dd class="text-right font-medium">{d.tools.join(', ')}</dd></div>
          </dl>
          {d.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">{d.tags.map((t) => <span class="chip">#{t}</span>)}</div>
          )}
        </div>
        </div>
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <section class="container-x mt-28">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight">More skills</h2>
        <a href="/skills" class="link inline-flex items-center gap-2 text-sm font-semibold">View all <Icon name="arrow" size={14} /></a>
      </div>
      <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s, i) => <SkillCard skill={s} index={i} />)}
      </ul>
    </section>
  )}
</Base>

<style>
  /* The skill's own "# Title" duplicates the sidebar <h1> */
  #panel-preview > :global(h1:first-child) { display: none; }
  .tab {
    position: relative; padding: 0.6rem 0.9rem; font-size: 0.9rem; font-weight: 600; color: var(--muted);
  }
  .tab[aria-selected='true'] { color: var(--ink); }
  .tab[aria-selected='true']::after {
    content: ''; position: absolute; inset-inline: 0.9rem; bottom: -1px; height: 2px; background: var(--ink);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
        });
      }),
    );
  });
</script>
