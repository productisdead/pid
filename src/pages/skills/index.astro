---
import Base from '@/layouts/Base.astro';
import DirectoryCard from '@/components/DirectoryCard.astro';
import Icon from '@/components/Icon.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getSkills, getRecommended } from '@/lib/content';
import { SITE } from '@/site.config';

const skills = await getSkills();
const picks = await getRecommended();
const total = skills.length + picks.length;
// One category list across both sources, biggest first
const counts = new Map<string, number>();
for (const c of [...skills, ...picks].map((x) => x.data.category)) counts.set(c, (counts.get(c) ?? 0) + 1);
const categories = [...counts].sort(([a, x], [b, y]) => y - x || a.localeCompare(b));
const sources = [
  ['', 'All', total],
  ['own', 'Original', skills.length],
  ['rec', 'Recommended', picks.length],
] as const;
---
<Base title="Skills hub" description="Free, drop-in agent skills (SKILL.md) that encode product judgment. For Claude, ChatGPT and Cursor.">
  <header class="relative overflow-hidden border-b border-line">
    <div class="dots pointer-events-none absolute inset-0 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <div class="container-x relative pb-12 pt-12 sm:pt-20">
      <p data-reveal class="eyebrow">Skills hub · {skills.length} original · {picks.length} recommended · all free</p>
      <h1 data-reveal style="--d:1" class="mt-4 max-w-4xl font-display text-[clamp(2.75rem,7vw,5.5rem)] font-extrabold leading-[0.95] tracking-[-0.04em]">
        Product judgment, <span class="marker" data-reveal>packaged</span> for agents.
      </h1>
      <p data-reveal style="--d:2" class="mt-6 max-w-2xl text-lg text-ink-2">
        Each skill is a single <code class="rounded bg-card px-1.5 py-0.5 font-mono text-[0.9em] ring-1 ring-line">SKILL.md</code> file.
        Drop it in your agent, and it stops writing generic slop and starts asking the questions a good PM would.
      </p>
      <p data-reveal style="--d:2" class="mt-4 text-sm text-muted">
        All open source.
        <a href={`${SITE.repo.url}/tree/${SITE.repo.branch}/skills`} target="_blank" rel="noopener" class="link inline-flex items-center gap-1.5 font-medium text-ink">
          <Icon name="github" size={14} /> Browse them on GitHub
        </a>
        · issues and PRs welcome.
      </p>
      <div data-reveal style="--d:3" class="mt-8 flex max-w-xl items-center gap-3 rounded-2xl border border-line bg-card p-1.5 pl-4 shadow-card focus-within:border-ink">
        <Icon name="search" class="shrink-0 text-muted" />
        <label for="skill-q" class="sr-only">Filter skills</label>
        <input id="skill-q" data-skill-q type="search" placeholder="Search skills: prd, animation, seo…" autocomplete="off" class="h-11 w-full bg-transparent outline-none placeholder:text-muted" />
      </div>
    </div>
  </header>

  <section id="skills" aria-label="Skills" class="container-x mt-10 scroll-mt-20">
    <!-- toolbar: source + sort -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div role="group" aria-label="Source" class="seg">
        {sources.map(([v, l, n]) => (
          <button type="button" data-source-btn={v} aria-pressed={v === '' ? 'true' : 'false'}>{l} <span>{n}</span></button>
        ))}
      </div>
      <div role="group" aria-label="Sort" class="seg">
        {[['featured', 'Featured'], ['new', 'Newest'], ['az', 'A–Z']].map(([v, l], i) => (
          <button type="button" data-sort={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>
        ))}
      </div>
    </div>

    <!-- categories: one scrollable row -->
    <nav aria-label="Categories" class="relative mt-4 border-b border-line">
      <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-4 sm:mx-0 sm:flex-wrap sm:px-0 [scrollbar-width:none]">
        <li><button type="button" data-cat="" aria-pressed="true" class="chip">All</button></li>
        {categories.map(([c, n]) => (
          <li><button type="button" data-cat={c} aria-pressed="false" class="chip">{c} <span>{n}</span></button></li>
        ))}
      </ul>
    </nav>

    <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <p class="text-sm text-muted" aria-live="polite"><span data-skill-count>{total}</span> skills</p>
      <p data-rec-note hidden class="text-sm text-muted">Other people's skills I've run on real work and would install again.</p>
    </div>

    <ul data-skill-grid class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((s, i) => <DirectoryCard kind="own" skill={s} index={i} />)}
      {picks.map((p, i) => <DirectoryCard kind="rec" pick={p} index={skills.length + i} />)}
    </ul>
    <div data-skill-empty hidden class="py-24 text-center">
      <img src="/brand/cat-head.svg" alt="" width="96" height="96" class="mx-auto w-24 opacity-80" />
      <p class="hand mt-4 text-3xl">No skills match that.</p>
      <p class="mt-1 text-muted">The cat suggests a shorter search.</p>
    </div>
  </section>

  <div class="container-x mt-28"><Newsletter compact /></div>
</Base>

<style>
  .seg { display: inline-flex; gap: 2px; border-radius: 9999px; border: 1px solid var(--line); background: var(--card); padding: 3px; font-size: 0.875rem; }
  .seg button { display: inline-flex; align-items: center; gap: 0.45rem; border-radius: 9999px; padding: 0.35rem 0.9rem; font-weight: 500; color: var(--muted); transition: background-color .2s, color .2s; }
  .seg button:hover { color: var(--ink); }
  .seg button span { font-family: var(--font-mono); font-size: 0.7rem; opacity: 0.7; }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .chip {
    display: inline-flex; align-items: center; gap: 0.45rem; white-space: nowrap; border-radius: 9999px;
    border: 1px solid var(--line); background: var(--card); padding: 0.4rem 0.9rem;
    font-size: 0.875rem; font-weight: 500; color: var(--ink-2); transition: background-color .2s, color .2s, border-color .2s;
  }
  .chip span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .chip:hover { border-color: var(--line-strong); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip[aria-pressed='true'] span { color: inherit; opacity: 0.6; }
</style>

<script>
  function initSkills() {
    const grid = document.querySelector<HTMLElement>('[data-skill-grid]');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-item]')];
    const q = document.querySelector<HTMLInputElement>('[data-skill-q]')!;
    const catBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const srcBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-source-btn]')];
    const sortBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-sort]')];
    const countEl = document.querySelector('[data-skill-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-skill-empty]')!;
    const recNote = document.querySelector<HTMLElement>('[data-rec-note]')!;

    const params = new URLSearchParams(location.search);
    let cat = params.get('category') ?? '';
    let source = params.get('source') ?? '';
    let sort = params.get('sort') ?? 'featured';
    q.value = params.get('q') ?? '';

    // Originals first, then by featured/date
    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      featured: (a, b) =>
        +(b.dataset.source === 'own') - +(a.dataset.source === 'own') ||
        +b.dataset.featured! - +a.dataset.featured! ||
        +b.dataset.date! - +a.dataset.date!,
      new: (a, b) => +b.dataset.date! - +a.dataset.date!,
      az: (a, b) => a.dataset.title!.localeCompare(b.dataset.title!),
    };

    const apply = () => {
      const term = q.value.trim().toLowerCase();
      const inScope = (el: HTMLElement) =>
        (!source || el.dataset.source === source) &&
        (!term || term.split(/\s+/).every((t) => el.dataset.haystack!.includes(t)));
      let shown = 0;
      [...cards].sort(sorters[sort] ?? sorters.featured).forEach((el, i) => {
        el.style.order = String(i);
        const ok = inScope(el) && (!cat || el.dataset.category === cat);
        el.hidden = !ok;
        if (ok) { shown++; el.classList.add('is-visible'); }
      });
      // Category chips reflect the current source + search; hide empty ones
      catBtns.forEach((b) => {
        const c = b.dataset.cat ?? '';
        if (c) {
          const n = cards.filter((el) => el.dataset.category === c && inScope(el)).length;
          b.parentElement!.hidden = n === 0 && cat !== c;
          b.querySelector('span')!.textContent = String(n);
        }
        b.setAttribute('aria-pressed', String(c === cat));
      });
      countEl.textContent = String(shown);
      empty.hidden = shown > 0;
      recNote.hidden = source !== 'rec';
      srcBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.sourceBtn ?? '') === source)));
      sortBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === sort)));
      const p = new URLSearchParams();
      if (source) p.set('source', source);
      if (cat) p.set('category', cat);
      if (sort !== 'featured') p.set('sort', sort);
      if (term) p.set('q', term);
      history.replaceState(history.state, '', (p.size ? `?${p}` : location.pathname) + location.hash);
    };

    catBtns.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat ?? ''; apply(); }));
    srcBtns.forEach((b) => b.addEventListener('click', () => { source = b.dataset.sourceBtn ?? ''; apply(); }));
    sortBtns.forEach((b) => b.addEventListener('click', () => { sort = b.dataset.sort!; apply(); }));
    q.addEventListener('input', apply);
    apply();
  }
  document.addEventListener('astro:page-load', initSkills);
</script>
