---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostRow from '@/components/PostRow.astro';
import { getPosts, slugify, uniqueSorted } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = uniqueSorted(posts.flatMap((p) => p.data.tags));
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), tags },
  }));
}
const { tag, posts, tags } = Astro.props;
---
<Base title={`#${tag}`} description={`Essays tagged ${tag}.`}>
  <PageHeader eyebrow={`Writing · ${posts.length} tagged`} title={`#${tag}`}>
    <div class="flex flex-wrap gap-2">
      <a href="/writing" class="chip">All</a>
      {tags.map((t) => <a href={`/writing/tag/${slugify(t)}`} class="chip" aria-current={t === tag ? 'page' : undefined}>#{t}</a>)}
    </div>
  </PageHeader>
  <section class="container-x">
    <ul class="border-t border-line">{posts.map((post, i) => <PostRow post={post} index={i} />)}</ul>
  </section>
</Base>
